        <TextView android:textSize="16.0sp" android:textColor="@color/white" android:gravity="center" android:id="@+id/messageBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/measure_loading_body" />
