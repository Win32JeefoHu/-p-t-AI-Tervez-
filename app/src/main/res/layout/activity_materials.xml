<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="@color/navy" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:padding="20.0dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="20.0sp" android:textStyle="bold" android:textColor="@color/cyan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8.0dp" android:text="@string/materials_title" />
        <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12.0dp" android:text="@string/materials_hint" />

        <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/materials_category" />
        <Spinner android:id="@+id/spinnerCategory" android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_area" />
        <EditText android:textColor="@color/white" android:textColorHint="@color/muted" android:id="@+id/inputArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

        <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_waste" />
        <EditText android:textColor="@color/white" android:id="@+id/inputWaste" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />

        <!-- Szigetelés -->
        <LinearLayout android:id="@+id/panelInsulation" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_thickness_cm" />
            <EditText android:textColor="@color/white" android:id="@+id/inputThickness" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_insul_type" />
            <Spinner android:id="@+id/spinnerType" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Festés -->
        <LinearLayout android:id="@+id/panelPaint" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_paint_coats" />
            <EditText android:textColor="@color/white" android:id="@+id/inputPaintCoats" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_paint_coverage" />
            <EditText android:textColor="@color/white" android:id="@+id/inputPaintCoverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Vakolat / glett -->
        <LinearLayout android:id="@+id/panelPlaster" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_plaster_mm" />
            <EditText android:textColor="@color/white" android:id="@+id/inputPlasterMm" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_plaster_bag" />
            <EditText android:textColor="@color/white" android:id="@+id/inputPlasterBagKg" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Padlóburkolat: csak terület + hulladék (közös mezők) -->
        <LinearLayout android:id="@+id/panelFlooring" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_flooring_hint" />
        </LinearLayout>

        <!-- Csempe -->
        <LinearLayout android:id="@+id/panelTile" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_wall_factor" />
            <EditText android:textColor="@color/white" android:id="@+id/inputWallFactor" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_wall_area_override" />
            <EditText android:textColor="@color/white" android:id="@+id/inputWallArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:hint="0 = automatikus" android:textColorHint="@color/muted" />
        </LinearLayout>

        <!-- Ragasztó / fugázó -->
        <LinearLayout android:id="@+id/panelAdhesive" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_adhesive_kg" />
            <EditText android:textColor="@color/white" android:id="@+id/inputAdhesiveKg" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_grout_kg" />
            <EditText android:textColor="@color/white" android:id="@+id/inputGroutKg" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Nyílászárók / lépcső info -->
        <LinearLayout android:id="@+id/panelOpenings" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_openings_hint" />
        </LinearLayout>
        <LinearLayout android:id="@+id/panelStairs" android:orientation="vertical" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textColor="@color/muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12.0dp" android:text="@string/materials_stairs_hint" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnCalc" android:layout_width="match_parent" android:layout_height="52.0dp" android:layout_marginTop="20.0dp" android:text="@string/materials_calc_btn" />
        <TextView android:textSize="15.0sp" android:textColor="@color/white" android:id="@+id/calcResult" android:background="@color/panel" android:padding="16.0dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16.0dp" android:layout_marginBottom="16.0dp" android:lineSpacingExtra="4.0dp" />
    </LinearLayout>
</ScrollView>
